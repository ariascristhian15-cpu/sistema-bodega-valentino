# Puerto de la aplicación (Render asigna process.env.PORT automáticamente)
PORT=3000

# Credenciales de Supabase (PostgreSQL en la Nube)
# URL EXACTA del proyecto: sin barra final y sin /rest/v1
#   ✅ https://abcdefghijklmnop.supabase.co
#   ❌ https://abcdefghijklmnop.supabase.co/
#   ❌ https://abcdefghijklmnop.supabase.co/rest/v1
SUPABASE_URL=https://tu-proyecto.supabase.co

# Publishable key (nueva) o anon key legacy (JWT). NUNCA uses la service_role/secret key.
SUPABASE_ANON_KEY=tu-publishable-o-anon-key-aqui

# Opcional: timeout de red hacia Supabase en milisegundos
SUPABASE_TIMEOUT_MS=15000

# Entorno
NODE_ENV=production
