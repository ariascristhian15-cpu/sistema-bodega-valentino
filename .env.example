# Puerto de la aplicación (Render asigna process.env.PORT automáticamente)
PORT=3000

# Credenciales de Supabase (PostgreSQL en la Nube)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-public-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-opcional

# Entorno
NODE_ENV=production
